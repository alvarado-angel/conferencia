digraph G {
	label="Árbol de sintaxis";
	labelloc="t";
	fontsize=20;
	fontname="Arial";
	node [shape=circle];
	node [shape=circle, style="filled", fillcolor="#EBF5FB", color="#2980B9", fontname="Helvetica",
		fontcolor="#2C3E50", penwidth=2, width=0.8];
	edge [color="#7F8C8D", penwidth=1.5];
	node0 [label="+"];
	node1 [label="1"];
	node0 -> node1;
	node2 [label="/"];
	node3 [label="**"];
	node4 [label="3"];
	node3 -> node4;
	node5 [label="2"];
	node3 -> node5;
	node2 -> node3;
	node6 [label="10"];
	node2 -> node6;
	node0 -> node2;
}
